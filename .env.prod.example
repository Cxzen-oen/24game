# 生产环境变量：复制为 .env.prod 后填写，chmod 600，绝不提交
# 生成密码：openssl rand -hex 24
POSTGRES_DB=game24
POSTGRES_USER=game24
POSTGRES_PASSWORD=CHANGE_ME

# 生成：openssl rand -hex 32（至少 32 字节）
JWT_SECRET=CHANGE_ME

# 绑定域名；没有域名时先填服务器公网 IP（仅 HTTP 调试）
DOMAIN=game24.example.com

# 走 HTTPS 时必须是 true；纯 HTTP 调试临时改 false
COOKIE_SECURE=true

# 镜像标签，便于回滚
APP_TAG=1.0.0

# 2C2G 小规模测试：用预构建 jar 的轻量镜像，避免在服务器上跑 Maven/Node
APP_DOCKERFILE=deploy/Dockerfile.runtime
APP_MEM_LIMIT=900m
DB_MEM_LIMIT=640m
PROXY_MEM_LIMIT=96m
